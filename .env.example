# Django 配置
DEBUG=False
SECRET_KEY=django-insecure-a+yv1#vy#nmy2bx8eguc9gp$+0+7ez^qi(4=v^i8gl&8+123gp)
ALLOWED_HOSTS=*

# DATABASES 配置
# 1、单机部署：保持下面 MySQL 配置注释状态，系统自动使用 SQLite（无需安装数据库）
# 2、多机部署：必须取消注释并填写以下 MySQL 配置，并且所有机器的数据库配置必须一致
# NAME=task_scheduler
# USER=root
# PASSWORD=your-password
# HOST=127.0.0.1
# PORT=3306

# 跨机调度：Django 运行端口，用于远程触发任务【多机部署时，所有机器的端口必须保持一致】
SCHEDULER_API_PORT=8000